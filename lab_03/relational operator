#include <stdio.h>

int main() {
    int x = 10;
    int y = 12;
    printf("YUVRAJ JOSHI \n");
    printf("x=%d,y=%d \n",x,y);
    printf("is x equal to y?  :- %d\n    ",x==y);
    printf("is x not equal to y? :- %d\n",x!=y);
    printf("is x greater than y? :- %d\n",x>y);
    printf("is x smaller than y? :- %d\n",x<y);
    printf("is x greater than equals to y? :- %d \n",x>=y);
    printf("is x smaller than equals to y? :- %d \n",x<=y);
    
    return 0;
}
