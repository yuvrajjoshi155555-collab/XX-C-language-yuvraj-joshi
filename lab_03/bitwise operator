#include <stdio.h>

int main() {
    int x = 10;
    int y = 12;
    printf("YUVRAJ JOSHI \n");
    printf("x=%d,y=%d \n",x,y);
    printf("bitwise AND   :- %d\n",x&y);
    printf("bitwise OR  :- %d\n",x|y);
    printf("bitwise XOR :- %d\n",x^y);
    printf("bitwise NOT :- %d\n",~x);
    printf("bitwise NOT:- %d\n",~y);
    printf("left shift :- %d \n",x<<y);
    printf("right shift :- %d \n",x>>y);
    
    return 0;
}
